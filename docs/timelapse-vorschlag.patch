@@ -0,0 +1,48 @@
+/*****************************************************************************
+ * Proposed central timelapse quality knobs (Phase 2 proposal).
+ * Until printer.cfg parsing is wired, these compile-time defaults apply.
+ * Stock baseline was: 640x360, VIDEO_FPS 30, bit_rate 2Mbps, preset ultrafast,
+ * no CRF, PIC_MAX_SIZE 100KiB.
+ *****************************************************************************/
+#pragma once
+
+/* Capture / encode geometry — keep 640x360 until camera enum confirms higher. */
+#ifndef TIMELAPSE_WIDTH
+#define TIMELAPSE_WIDTH 640
+#endif
+#ifndef TIMELAPSE_HEIGHT
+#define TIMELAPSE_HEIGHT 360
+#endif
+
+#ifndef TIMELAPSE_OUTPUT_FPS
+#define TIMELAPSE_OUTPUT_FPS 30
+#endif
+
+/* H.264 encode */
+#ifndef TIMELAPSE_BIT_RATE
+#define TIMELAPSE_BIT_RATE 4000000
+#endif
+#ifndef TIMELAPSE_X264_PRESET
+#define TIMELAPSE_X264_PRESET "medium"
+#endif
+#ifndef TIMELAPSE_X264_TUNE
+#define TIMELAPSE_X264_TUNE "stillimage"
+#endif
+#ifndef TIMELAPSE_X264_PROFILE
+#define TIMELAPSE_X264_PROFILE "main"
+#endif
+#ifndef TIMELAPSE_X264_LEVEL
+#define TIMELAPSE_X264_LEVEL "3.1"
+#endif
+#ifndef TIMELAPSE_CRF
+#define TIMELAPSE_CRF 20
+#endif
+
+/* MJPEG frame buffer (was 100*1024) */
+#ifndef TIMELAPSE_PIC_MAX_SIZE
+#define TIMELAPSE_PIC_MAX_SIZE (300 * 1024)
+#endif
+
+#ifndef TIMELAPSE_KEEP_SOURCE_JPEGS
+#define TIMELAPSE_KEEP_SOURCE_JPEGS 0
+#endif
